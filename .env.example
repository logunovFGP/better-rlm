# Reuse your Claude Code login — NO Anthropic API key needed.
# Run once:   claude setup-token        (requires a Claude subscription)
# then paste the long-lived token here:
CLAUDE_CODE_OAUTH_TOKEN=

# Optional, explicit fallback ONLY (leave unset to use Claude Code OAuth above).
# If set, it is used only when CLAUDE_CODE_OAUTH_TOKEN is absent.
# ANTHROPIC_API_KEY=sk-ant-...
