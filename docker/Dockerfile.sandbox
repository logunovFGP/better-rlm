# Sandbox image for the RLM Docker REPL.
# The engine pip-installs `dill` + `requests` into the container at startup;
# prebaking them avoids runtime PyPI access and lets you lock down egress.
# Build:  docker build -t rlm-sandbox -f docker/Dockerfile.sandbox docker/
FROM python:3.11-slim
RUN pip install --no-cache-dir dill requests
WORKDIR /workspace
